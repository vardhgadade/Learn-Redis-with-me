# ==============================
# Application
# ==============================
APP_NAME=Redis Learning API
APP_ENV=development
DEBUG=true

# ==============================
# PostgreSQL
# ==============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=redis_learning

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/redis_learning

# ==============================
# Redis
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0